{
  "name": "food-truck-finder-public",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
